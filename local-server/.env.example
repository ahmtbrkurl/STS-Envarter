# Bu dosyayi ".env" olarak kopyalayip kendi degerlerinizi girin.
# ".env" dosyasini ASLA paylasmayin/git'e eklemeyin - icinde gizli bilgi olabilir.

# Google Sheet'inizin URL'sindeki uzun ID (docs.google.com/spreadsheets/d/BURASI/edit)
SPREADSHEET_ID=1a80kEp0BDqCZizrefxjiwOCSTe3Yqa8KXHahUl580Iw

# HR Master Log'un kendi Sheet ID'si (Apps Script Script Properties > HR_SHEET_ID ile ayni)
HR_SHEET_ID=1pn8L5pxO_kWNmnWJktu3VXsO6k874Hdh9zxvt72F0tA
# Bos birakirsaniz HR sheet'indeki ILK sekme kullanilir. Belirli bir sekme adi
# kullanmak isterseniz buraya yazin.
HR_SHEET_TAB=

# Dosya yukleme ve yedekleme icin Google Drive klasor ID'leri (Apps Script
# Script Properties'deki degerlerle AYNI olmali). Bu klasorleri de servis
# hesabinizla (Duzenleyen/Editor olarak) paylasmaniz gerekir.
DRIVE_FOLDER_ID=1J17o6p64UTLuFfBAoUAKJDFUx9UDvUvz
TESLIM_FORM_FOLDER_ID=1mgASNsFs72GFuR7U6B6GDhR-_BzVN_lp
BACKUP_FOLDER_ID=1GsL-bBU_fuKU7eoJrVxhBYCcrKQoQTw5

# Genel (public) QR goruntuleme sayfasi icin kod - Apps Script'teki PUBLIC_QR_CODE ile ayni
PUBLIC_QR_CODE=sts2026

# Drive'a dosya yukleme/yedekleme icin - servis hesabinin depolama kotasi
# OLMADIGI icin bu islemler SIZIN KENDI Google hesabiniz adina yapilir.
# Asagidaki 2 degeri Google Cloud Console'dan alip, sonra "node oauthSetup.js"
# calistirin - bkz. README.md > "Drive icin OAuth kurulumu"
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Google Cloud'dan indirdiginiz servis hesabi JSON dosyasinin yolu
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Uygulamaya giris sifreniz (Apps Script'teki Script Properties > APP_TOKEN ile AYNI olmali)
APP_TOKEN=

# Sunucunun calisacagi port (degistirmenize gerek yok)
PORT=8787
